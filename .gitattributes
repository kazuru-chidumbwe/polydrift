# Auto-normalize text files to LF (reviewer SHA-256 stability on Linux/macOS)
* text=auto eol=lf
results/**/*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.cff text eol=lf
# SIP fixtures are wire bytes: CRLF line ends (RFC 3261 Section 7) and exact Content-Length. Never normalise.
fixtures/*.sip -text
