# polydrift sipb: reSIProcate repro as stateful proxy and registrar for lab.test; repro's defaults kept where the
# role allows. Lab-only: digest authentication off, no TLS, no web admin.
UDPPort = 5060
TCPPort = 5060
TLSPort = 0
DTLSPort = 0
WSPort = 0
WSSPort = 0
Domains = lab.test, 172.31.60.10
RecordRouteUri = sip:172.31.60.10;lr
ForceRecordRouting = true
DisableAuth = true
DisableRegistrarAuth = true
# HttpPort = 0 should disable the web admin, but repro 1.12 to 1.14 then refuse to start (createWebAdmin returns
# false when no web admin is created). The web admin listens on loopback only instead.
HttpPort = 5080
HttpBindAddress = 127.0.0.1
CommandPort = 0
DatabasePath = /var/lib/repro
LoggingType = cout
LogLevel = INFO
EnableCertServer = false
