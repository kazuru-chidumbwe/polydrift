  "build": {
    "pd-bind:9.16.50": {
      "dockerfile": "polydrift/cells/dns/lab/images/bind.Dockerfile",
      "context": "polydrift/cells/dns/lab/images",
      "args": {
        "VER": "9.16.50"
      },
      "why": "no upstream image for the 9.16 line (Docker Hub has no bind9:9.16 tag, checked 18 Nov 2026); 9.16.50 is the last 9.16 release on downloads.isc.org"
    },
    "pd-apacheds:2.0.0.AM26": {
      "dockerfile": "polydrift/cells/ldap/images/apacheds.Dockerfile",
      "context": "polydrift/cells/ldap/images",
      "args": {
        "VER": "2.0.0.AM26",
        "BASE": "ubuntu:22.04",
        "JDK": "11"
      },
      "why": "2.0.0.AM26 creates its self-signed certificate through JDK internals (sun.security.x509, sun.security.util); JDK 17 and later refuse that access (IllegalAccessError at start, campaign dry runs 18 and 19 Nov 2026, also with the x509 export), JDK 11 permits it. Ubuntu 22.04 ships openjdk-11; checked 19 Nov 2026: the server listens on 10389 with no exception"
    }
